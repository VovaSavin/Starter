<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	  <UseWindowsForms>true</UseWindowsForms>
	  <EmbedInteropTypes>true</EmbedInteropTypes>
	  <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="edit.ps1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="edit.ps1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerShell.Commands.Diagnostics" Version="7.4.11" />
    <PackageReference Include="Microsoft.PowerShell.Commands.Management" Version="7.4.11" />
    <PackageReference Include="Microsoft.PowerShell.Commands.Utility" Version="7.4.11" />
    <PackageReference Include="Microsoft.PowerShell.ConsoleHost" Version="7.4.11" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.5.2" />
    <PackageReference Include="Microsoft.WSMan.Management" Version="7.4.11" />
    <PackageReference Include="System.Management.Automation" Version="7.4.11" />
  </ItemGroup>

</Project>
